# Docker Environment Variables for RomaSub.AI
# Copy this file to .env and customize the values

# JWT Configuration (REQUIRED - change this!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production-use-openssl-rand-hex-32

# Database Configuration (managed by docker-compose, no need to change)
# DATABASE_URL is automatically set in docker-compose.yml

# Whisper Configuration
WHISPER_MODEL=small

# File Upload Configuration
MAX_FILE_SIZE_MB=500

# Google OAuth Configuration (OPTIONAL)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo Configuration (OPTIONAL — transactional email for OTPs)
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@romasub.ai
BREVO_SENDER_NAME=RomaSub.AI

# Notes:
# - If you don't set GOOGLE_CLIENT_ID/SECRET, Google OAuth will be disabled
# - If you don't set BREVO_API_KEY, OTP codes will be printed to console
# - The SECRET_KEY should be a long random string (use: openssl rand -hex 32)
