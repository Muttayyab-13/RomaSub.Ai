# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/romasub_ai

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Brevo Configuration (transactional email — get a key at https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=RomaSub.AI

# Whisper / ASR Configuration
# WHISPER_BACKEND selects where transcription runs:
#   groq    Groq-hosted Whisper large-v3-turbo (fastest; needs GROQ_API_KEY).
#           Automatically falls back to local faster-whisper if Groq is
#           unreachable / out of credits / the file is too large.
#   faster  local faster-whisper (CTranslate2, int8) — offline, low RAM.
#   openai  local openai-whisper (original behaviour).
WHISPER_BACKEND=groq
# Local model used by the faster/openai backends (and the groq fallback).
WHISPER_MODEL=small
# faster-whisper CPU quantization: int8 | int8_float16 | float32
WHISPER_COMPUTE_TYPE=int8

# Groq hosted Whisper — get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=whisper-large-v3-turbo

# File Upload Configuration
MAX_FILE_SIZE_MB=2048
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mkv,mov,webm
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,flac,ogg

# Storage locations — leave unset to use the defaults shown (durable across runs).
#   MEDIA_UPLOAD_DIR  uploaded media (videos/audio + extracted audio)  default: <repo>/uploads/media
#   STATE_DIR         runtime JSON state (subtitle_state.json,         default: <repo>/app/data
#                     file_registry.json) — backs the "recents" list
# Override only to relocate them, e.g. onto a mounted disk (use absolute paths):
# MEDIA_UPLOAD_DIR=/var/lib/romasub/media
# STATE_DIR=/var/lib/romasub/state
